{
    "manifest_version": 3,
    "name": "BetterTabTool",
    "description": "A tool to help you manage your tabs and windows efficiently.",
    "version": "0.2.1",
    "minimum_chrome_version": "120",
    "permissions": [
        "tabs",
        "tabGroups",
        "windows",
        "storage",
        "clipboardWrite",
        "scripting",
        "notifications",
        "contextMenus",
        "alarms",
        "system.display"
    ],
    "icons": {
        "16": "assets/icon-16.png",
        "48": "assets/icon-48.png",
        "128": "assets/icon-128.png",
        "512": "assets/icon-512.png"
    },
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "BetterTabTool"
    },
    "commands": {
        "copy-current-tab-url": {
            "description": "Copy current tab URL"
        },
        "open-new-tab-in-current-group": {
            "description": "Open new tab in current group"
        },
        "duplicate-tab": {
            "description": "Duplicate current tab"
        },
        "merge-all-windows": {
            "description": "Merge all windows"
        },
        "pop-out-current-tab": {
            "description": "Pop out current tab into a new window."
        },
        "close-all-popup-windows": {
            "description": "Close all popup windows"
        }
    }
}
